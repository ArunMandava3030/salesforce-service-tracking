<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Customer Technician Tracking</masterLabel>
    <description>Private customer tracking link with live technician location and driving ETA.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="publicPublisherPageUrl" type="String" label="Public GPS publisher page URL"
                default="https://example.my.site.com/LiveTracking/apex/TechnicianGpsInvite"
                description="Used to locate the same-site map page." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
